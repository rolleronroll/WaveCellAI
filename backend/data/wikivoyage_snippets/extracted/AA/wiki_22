itle\": \"Helderberg Marine Protected Area\",\n \"description\": \"Seaward boundary\",\n \"stroke\":\"#ffff00\",\n \"stroke-width\":3\n&lt;/maplink&gt;\n&lt;maplink text=\"\" latitude=\"-34.0\" longitude=\"18.6\" zoom=\"9\" group=\"BBMPA\" class=\"no-icon\"&gt;\n {\"coordinates\":\n18.896083,-34.374167],[18.896083,-34.407500],[18.937333,-34.407500],[18.937333,-34.355950,\n \"type\":\"LineString\"},\n \"properties\":{\n \"title\": \"Betty's Bay Marine Protected Area\",\n \"description\": \"Seaward boundary\",\n \"stroke\":\"#ffff00\",\n \"stroke-width\":3\n&lt;/maplink&gt;\n&lt;maplink text=\"\" latitude=\"-34.0\" longitude=\"24.9\" zoom=\"9\" group=\"TMPA\" class=\"no-icon\"&gt;\n {\"coordinates\":\n24.19425,-34.060],[24.19425,-34.11],\n[23.647617,-34.030283],[23.647617,-33.988617],\n[23.576017,-33.991667],[23.576017,-33.983333,\n \"type\":\"LineString\"},\n \"properties\":{\n \"title\": \"Tsitsikamma Marine Protected Area\",\n \"description\": \"Seaward boundary\",\n \"stroke\":\"#ffff00\",\n \"stroke-width\":3\n&lt;/maplink&gt;\n&lt;maplink text=\"\" latitude=\"-33.9\" longitude=\"25.8\" zoom=\"8\" group=\"AENPMPA\" class=\"no-icon\"&gt;\n {\"coordinates\":\n25.721217,-33.779867],[25.700000,-33.802783],[25.700000,-33.875000],[26.529533,-33.875000],[26.529533,-33.753367,\n \"type\":\"LineString\"},\n \"properties\":{\n \"title\": \"Addo Elephant National Park Marine Protected Area\",\n \"description\": \"Seaward boundary\",\n \"stroke\":\"#ffff00\",\n \"stroke-width\":3\n&lt;/maplink&gt;\n&lt;maplink text=\"\" latitude=\"-33.9\" longitude=\"25.8\" zoom=\"8\" group=\"BIRZ\" class=\"no-icon\"&gt;\n {\"coordinates\":\n26.152727,-33.720950],[26.324300,-33.767283],[26.324300,-33.767283],[26.489167,-33.765850],\n[26.489167,-33.875000],[26.166667,-33.875000],[26.152727,-33.720950,\n \"type\":\"LineString\"},\n \"properties\":{\n \"title\": \"Bird Island Restricted Area\",\n \"description\": \"Seaward boundary\",\n \"stroke\":\"#ff9900\",\n \"stroke-width\":2\n&lt;/maplink