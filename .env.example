# ---------- Backend ----------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Shared secret the Android gateway sends in the X-Gateway-Secret header
GATEWAY_SHARED_SECRET=change-me

# ---------- Small model tier: Google Gemini (active) ----------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: lower thinking to keep output-token cost down.
# Leave empty to use the model default; check Google's docs for valid values.
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT_S=20

# ---------- Fallback tier: Claude (active) ----------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_S=30

# Small-model answers scoring below this go to Claude (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.65

# Which tier answers first: "gemini" (default). "local" is reserved, see local_llm.py
SMALL_LLM_PROVIDER=gemini

# ---------- Local AI: Ministral-8B (DISABLED, kept for future use) ----------
# Needs a host you run yourself (llama.cpp llama-server). Uncomment together with
# backend/src/router/local_llm.py and the matching lines in config.py.
# LOCAL_AI_URL=http://localhost:8080
# LOCAL_AI_TOKEN=
# LOCAL_AI_MODEL=Ministral-8B-Instruct-2410-Q4_K_M.gguf
# LOCAL_AI_TIMEOUT_S=30

# ---------- Translation ----------
# "claude" or "gemini"
TRANSLATOR_BACKEND=gemini

# ---------- Knowledge base (SQLite) ----------
SQLITE_PATH=./output/knowledge.db
DATA_DIR=../data
OUTPUT_DIR=./output

# ---------- SMS economics (for analytics) ----------
SMS_COST_PER_SEGMENT_USD=0.0075
ROAMING_DATA_COST_PER_MB_USD=10.0

# ---------- Emergency escalation ----------
EMERGENCY_WEBHOOK_URL=